# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://actverge:actverge@postgres:5432/actverge
REDIS_URL=redis://redis:6379/0
ARQ_REDIS_URL=redis://redis:6379/1

# ── Storage (MinIO) ──────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=actverge-artifacts

# ── LLM Configuration (Option 2: OpenRouter Universal API) ────────────────────
# Single API key giving access to Claude, GPT-4o, and Gemini
OPENROUTER_API_KEY=
LITELLM_MASTER_KEY=sk-actverge-local-dev-key

# ── Observability ─────────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=PENDING_APPROVAL
LANGCHAIN_PROJECT=actverge
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=actverge-backend

# ── Evaluation & Benchmarking (Mind2Web) ───────────────────────────────────
# Optional: HuggingFace access token for on-the-fly streaming of Mind2Web
HF_TOKEN=

# ── App Settings ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

