# ============================================================
# ActVerge Backend Environment Variables
# Copy this file to .env and fill in values.
# ============================================================

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://actverge:actverge@localhost:5432/actverge

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Storage (MinIO / S3-compatible) ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=actverge-artifacts

# ---- LLM API Keys (set after model selection is approved) ----
# TODO: Set model names and keys after user approval
INTERPRETER_API_KEY=PENDING
VERIFIER_API_KEY=PENDING
MULTIMODAL_API_KEY=PENDING
FALLBACK_API_KEY=PENDING
LITELLM_MASTER_KEY=PENDING

# ---- Observability ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=PENDING
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---- ARQ Worker ----
ARQ_REDIS_URL=redis://localhost:6379/1

# ---- App Settings ----
APP_ENV=development
LOG_LEVEL=INFO
